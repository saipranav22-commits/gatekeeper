# ==============================================================================
# Gatekeeper Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure strong secrets before running containers.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Project & Active Spring Profile
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=gatekeeper-deploy
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper_app
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_database_password_24chars

# Database host & port for Gateway container (internal Docker DNS uses 'postgres')
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=replace_with_strong_redis_password_24chars
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# MUST be at least 32 characters (256 bits) of high-entropy secret.
# Generate with: openssl rand -hex 32
GATEKEEPER_JWT_SECRET=replace_with_at_least_32_bytes_of_random_secret_entropy_for_hmac256!
GATEKEEPER_JWT_ISSUER=gatekeeper-auth
GATEKEEPER_JWT_EXPIRATION_SECONDS=900
GATEKEEPER_LOGIN_MAX_ATTEMPTS=5
GATEKEEPER_LOGIN_LOCKOUT_SECONDS=900

# ------------------------------------------------------------------------------
# Routing & Upstream Microservices
# ------------------------------------------------------------------------------
ORDERS_HOST=orders
ORDERS_UPSTREAM_URI=http://orders:8081
INVENTORY_HOST=inventory
INVENTORY_UPSTREAM_URI=http://inventory:8082

# ------------------------------------------------------------------------------
# Exposed Host Ports
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Frontend Environment
# ------------------------------------------------------------------------------
# In containerized reverse-proxy deployment, leave empty to route relative to origin (/api/)
# For split hosting (e.g., Vercel frontend + cloud VM gateway), set to full gateway URL (e.g. https://api.gatekeeper.dev)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# JVM Resource & Memory Tuning
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC
