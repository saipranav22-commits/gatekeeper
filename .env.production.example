# ==============================================================================
# Gatekeeper Backend Production Environment Template (.env.production.example)
# ==============================================================================
# Copy this file to .env.production on the target production host.
# NEVER commit the actual .env.production file containing real secrets to Git.
#
# Generate cryptographically secure random values (256-bit entropy) via:
#   openssl rand -hex 32
# ==============================================================================

# Database Configuration (PostgreSQL 16)
# Required on host: generate with `openssl rand -hex 24`
POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper_app
POSTGRES_PASSWORD=

# Cache & Distributed Concurrency State (Redis 7.4)
# Required on host: generate with `openssl rand -hex 24`
REDIS_PASSWORD=

# Security & Authentication (JWT Secret: HMAC-SHA256, >= 256 bits)
# Required on host: generate with `openssl rand -hex 32`
GATEKEEPER_JWT_SECRET=
GATEKEEPER_JWT_ISSUER=gatekeeper-auth
GATEKEEPER_JWT_EXPIRATION_SECONDS=900
GATEKEEPER_LOGIN_MAX_ATTEMPTS=5
GATEKEEPER_LOGIN_LOCKOUT_SECONDS=900

# CORS Allowed Origins (Comma-separated HTTPS origins permitted to access APIs)
GATEKEEPER_CORS_ALLOWED_ORIGINS=https://gatekeeper-ayh.pages.dev,http://localhost:3000,http://localhost:5173

# Gateway Local Port Binding (Bound strictly to 127.0.0.1 on the host)
GATEWAY_PORT=8080

# Cloudflare Tunnel Configuration (Optional zero-port secure HTTPS ingress)
# Obtain token from Cloudflare Zero Trust Dashboard > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
